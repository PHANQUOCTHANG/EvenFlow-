# ---- Ha tang ----
DATABASE_URL=postgres://eventflow:eventflow@localhost:6432/eventflow?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379/0
AMQP_URL=amqp://eventflow:eventflow@localhost:5672/

# ---- Bao mat ----
JWT_SECRET=doi-truoc-khi-len-production
QUEUE_TOKEN_SECRET=doi-truoc-khi-len-production
HMAC_QR_SECRET=doi-truoc-khi-len-production

# ---- AI (Anthropic) ----
# AI_MOCK=1 de dev khong ton quota (khong can key). AI_MOCK=0 bat buoc ANTHROPIC_API_KEY.
# Ten cu GEMINI_MOCK / GEMINI_TIMEOUT_SECONDS / GEMINI_RPM / GEMINI_TPM van duoc doc (alias,
# canh bao luc khoi dong, bo o ban sau). Ten moi thang ten cu BAT KE nguon: AI_MOCK trong file
# nay thang GEMINI_MOCK dat trong shell. Key: khoang trang hoac xuong dong bao ngoai duoc cat;
# khoang trang hay ky tu dieu khien ben trong thi worker tu choi khoi dong.
AI_MOCK=1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHAT=claude-haiku-5-5
ANTHROPIC_MODEL_MODERATION=claude-haiku-5-5
# Phai ngan hon TTL singleflight (30s).
AI_TIMEOUT_SECONDS=10
# Phan du max_tokens cho suy nghi cua model (cong ca vao giay phep limiter).
AI_THINKING_HEADROOM_TOKENS=1024
# Dat THAP hon han muc that ~10% de chua bien an toan (xem limiter.py).
AI_RPM=55
AI_TPM=900000

# ---- Embeddings (Gemini, optional) ----
# Chi cho cache ngu nghia L3. Rong o che do that: L3 tat (log mot lan), cache exact van chay.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=text-embedding-004

# ---- Phong cho ----
ADMIT_MIN_RATE=5
ADMIT_MAX_RATE=500
ADMIT_STEP_UP=10
ADMIT_BACKOFF=0.7
ADMIT_TTL_SECONDS=900

# ---- Ticketing ----
HOLD_TTL_SECONDS=600
INVENTORY_BUCKETS=32

# ---- Google SSO ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# ---- Su kien dang ban (giai doan 0, truoc khi co event-svc) ----
# Danh sach UUID phan cach bang dau phay; sweeper, seeder va admit controller quet
# nhung su kien nay. Mac dinh: su kien demo + su kien cua smoke test.
ACTIVE_EVENT_IDS=11111111-1111-4111-8111-111111111111,22222222-2222-4222-8222-222222222222

# ---- Compose: service Go don binary (gateway, identity, event, payment, notification) ----
# JWT_SECRET dung chung gateway + identity. Production bat buoc dat gia tri that.
# SMTP dev tro toi Mailpit (UI http://localhost:8025); Compose da cau hinh san.
PII_ENC_KEY=
PII_HASH_KEY=
