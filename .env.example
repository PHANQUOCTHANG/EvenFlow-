# ---- Ha tang ----
DATABASE_URL=postgres://eventflow:eventflow@localhost:6432/eventflow?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379/0
AMQP_URL=amqp://eventflow:eventflow@localhost:5672/

# ---- Bao mat ----
JWT_SECRET=doi-truoc-khi-len-production
QUEUE_TOKEN_SECRET=doi-truoc-khi-len-production
QR_HMAC_SECRET=doi-truoc-khi-len-production

# ---- Gemini ----
# GEMINI_MOCK=1 de dev khong ton quota.
GEMINI_API_KEY=
GEMINI_MOCK=1
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro
# Dat THAP hon han muc that ~10% de chua bien an toan (xem limiter.py).
GEMINI_RPM=55
GEMINI_TPM=900000

# ---- Phong cho ----
ADMIT_MIN_RATE=5
ADMIT_MAX_RATE=500
ADMIT_STEP_UP=10
ADMIT_BACKOFF=0.7
ADMIT_TTL_SECONDS=900

# ---- Ticketing ----
HOLD_TTL_SECONDS=600
INVENTORY_BUCKETS=32

# ---- Google SSO ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# ---- Su kien dang ban (giai doan 0, truoc khi co event-svc) ----
# Danh sach UUID phan cach bang dau phay; sweeper, seeder va admit controller quet
# nhung su kien nay. Mac dinh: su kien demo + su kien cua smoke test.
ACTIVE_EVENT_IDS=11111111-1111-4111-8111-111111111111,22222222-2222-4222-8222-222222222222
