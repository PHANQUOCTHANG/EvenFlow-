== make -n load
mkdir -p tests/load/results
k6 run -e PROFILE=smoke                       tests/load/main.js
== make -n load-seed
bash tests/load/seed-load.sh seed
== make -n load-verify
bash tests/load/seed-load.sh verify
== make -n load-smoke
bash tests/load/seed-load.sh seed
/usr/bin/make --no-print-directory load PROFILE=smoke
mkdir -p tests/load/results
k6 run -e PROFILE=smoke                       tests/load/main.js
== make -n test-load-lib
node --test tests/load/lib/*.test.mjs
== make -n load PROFILE=spike JOIN_TARGET=5000
make targets ok
