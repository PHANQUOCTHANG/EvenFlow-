# V1: drop X-Real-IP from clientIPHeaders (header no longer stripped)
diff --git a/services/gateway/internal/proxy/gateway.go b/services/gateway/internal/proxy/gateway.go
index 8dad2f8..4a6ba14 100644
--- a/services/gateway/internal/proxy/gateway.go
+++ b/services/gateway/internal/proxy/gateway.go
@@ -215,7 +215,7 @@ type forwardedClientKey struct{}
 // client gui truoc khi gan lai, nen client khong gia duoc IP qua header. Khi IP client lay tu
 // X-Forwarded-For cua proxy tin cay, upstream nhan dung mot phan tu la IP do.
 // clientIPHeaders la cac header mang IP client ma gateway khong dat; client gui thi bi xoa.
-var clientIPHeaders = []string{"Forwarded", "X-Real-IP", "True-Client-IP", "X-Original-Forwarded-For", "CF-Connecting-IP"}
+var clientIPHeaders = []string{"Forwarded", "True-Client-IP", "X-Original-Forwarded-For", "CF-Connecting-IP"}
 
