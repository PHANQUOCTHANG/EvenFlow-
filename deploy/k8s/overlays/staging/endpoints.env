# ConfigMap eventflow-endpoints (staging): external infra, PLACEHOLDER hosts the runbook says to
# replace. Infra hosts/ports only (contract section 9). Redis must be private and passwordless
# (no TLS/ACL in this task; runbook known limit).
REDIS_ADDR=redis.example.internal:6379
REDIS_URL=redis://redis.example.internal:6379/0
SMTP_HOST=smtp.example.internal
SMTP_PORT=587
# Empty = traces not exported; set to the OTLP HTTP collector when one exists.
OTEL_EXPORTER_OTLP_ENDPOINT=
