# ConfigMap eventflow-app-config (staging): explicit non-demo values (spec E2, E8; AC-32).
# Hosts are PLACEHOLDERS (staging.example.com); the runbook says to replace them.
# Deliberately ABSENT (code defaults apply): MIN_SALE_LEAD_SECONDS, ACTIVE_EVENT_IDS, ADMIT_*,
# PAYMENT_SANDBOX_MODE, any STRIPE_* (Stripe disabled in staging until its webhook signature
# check is fixed; spec E8.3).
APP_ENV=production
CORS_ALLOWED_ORIGINS=https://staging.example.com
# ai-worker calls Gemini for real; GEMINI_API_KEY is required in Secret eventflow-ai
GEMINI_MOCK=0
# payment: real provider test endpoints (code defaults), credentials from Secret eventflow-payment
PAYMENT_DEFAULT_PROVIDER=vnpay
PAYMENT_ENABLED_PROVIDERS=vnpay,momo
VNPAY_RETURN_URL=https://staging.example.com/
MOMO_RETURN_URL=https://staging.example.com/
# MoMo IPN must reach the gateway from the internet: needs a public API host
MOMO_NOTIFY_URL=https://api.staging.example.com/v1/payments/webhook/momo
# notification: real SMTP (credentials from Secret eventflow-notification)
EMAIL_PROVIDER=smtp
SMTP_FROM=no-reply@staging.example.com
# identity: Google OAuth client of the staging project (non-empty, AC-32)
GOOGLE_CLIENT_ID=REPLACE-ME-staging.apps.googleusercontent.com
