# DEV ONLY – never use outside a local cluster. Every value contains "dev" (spec AC-16).
# Source of all local Secrets: kustomization.yaml splits this file into the Secrets of
# policy-contract section 8 (one replacement per key), so each Secret holds only its keys.
# Staging never uses this file: its Secrets are created outside git (spec D4).
#
# POSTGRES_PASSWORD must equal the password inside both eventflow-db URLs, and
# RABBITMQ_DEFAULT_PASS the password inside AMQP_URL.

# --- eventflow-db (identity/event: DIRECT; ticketing, worker, payment, notification: POOLED)
DATABASE_URL_DIRECT=postgres://eventflow:dev-eventflow-pw@eventflow-postgres:5432/eventflow?sslmode=disable
DATABASE_URL_POOLED=postgres://eventflow:dev-eventflow-pw@eventflow-pgbouncer:5432/eventflow?sslmode=disable
# --- eventflow-mq
AMQP_URL=amqp://eventflow:dev-eventflow-mq-pw@eventflow-rabbitmq:5672/
# --- eventflow-auth (same dev defaults as compose)
JWT_SECRET=dev-jwt-secret-change-me-0123456789
QUEUE_TOKEN_SECRET=dev-queue-token-secret-change-me
# --- eventflow-qr (ticketing and ticketing-worker must share it)
HMAC_QR_SECRET=dev-qr-hmac-secret-change-me-32bytes!
# --- eventflow-identity: base64 of exactly 32 bytes (libs/go/pii, StdEncoding)
PII_ENC_KEY=devPiiEncKeyLocalClusterOnlyNeverProdAAAAAA=
PII_HASH_KEY=devPiiHashKeyLocalClusterOnlyNeverProdAAAAA=
# --- eventflow-payment (dummy provider credentials; sandbox is the default provider locally)
VNPAY_TMN_CODE=dev-vnpay-tmn
VNPAY_HASH_SECRET=dev-vnpay-hash-secret
MOMO_PARTNER_CODE=dev-momo-partner
MOMO_ACCESS_KEY=dev-momo-access-key
MOMO_SECRET_KEY=dev-momo-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_dev_eventflow
STRIPE_SECRET_KEY=sk_test_dev_eventflow
STRIPE_WEBHOOK_SECRET=whsec_dev_eventflow
# --- eventflow-ai (unused while GEMINI_MOCK=1)
GEMINI_API_KEY=dev-gemini-key-unused-with-mock
# --- eventflow-dev-infra (dev-infra Postgres/PgBouncer/RabbitMQ)
POSTGRES_PASSWORD=dev-eventflow-pw
RABBITMQ_DEFAULT_PASS=dev-eventflow-mq-pw
