# ConfigMap eventflow-endpoints (local): infra hosts/ports only (contract section 9).
# Hosts are the Service names of the dev-infra component (components/dev-infra).
REDIS_ADDR=eventflow-redis:6379
REDIS_URL=redis://eventflow-redis:6379/0
SMTP_HOST=eventflow-mailpit
SMTP_PORT=1025
# Empty = traces not exported (libs/go/otelx); no Jaeger runs in the cluster.
OTEL_EXPORTER_OTLP_ENDPOINT=
