# ConfigMap eventflow-app-config (local): dev/demo values, the same as deploy/compose
# where compose sets them (spec erratum E2 / E8.6). Never copy this file to staging.
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://eventflow.localtest.me
# event: short sale lead time for demos (code default 30 min, BR-E2)
MIN_SALE_LEAD_SECONDS=60
# waitingroom-controller, ticketing-worker: the two compose demo events
ACTIVE_EVENT_IDS=11111111-1111-4111-8111-111111111111,22222222-2222-4222-8222-222222222222
ADMIT_MIN_RATE=5
ADMIT_MAX_RATE=50
ADMIT_STEP_UP=10
ADMIT_BACKOFF=0.7
ADMIT_TTL_SECONDS=900
# ai-worker: no Gemini calls locally
GEMINI_MOCK=1
# payment: in-process sandbox ("true" in compose is not a valid mode; success|fail|delay)
PAYMENT_SANDBOX_MODE=success
PAYMENT_DEFAULT_PROVIDER=sandbox
PAYMENT_ENABLED_PROVIDERS=sandbox,vnpay,momo,stripe
# Fallback provider callbacks (the web passes a per-order return URL when it has one).
VNPAY_RETURN_URL=http://eventflow.localtest.me/
MOMO_RETURN_URL=http://eventflow.localtest.me/
MOMO_NOTIFY_URL=http://api.eventflow.localtest.me/v1/payments/webhook/momo
STRIPE_SUCCESS_URL=http://eventflow.localtest.me/
STRIPE_CANCEL_URL=http://eventflow.localtest.me/
# notification: send to Mailpit (SMTP_HOST/PORT come from eventflow-endpoints)
EMAIL_PROVIDER=smtp
SMTP_FROM=no-reply@eventflow.local
# identity: empty = Google sign-in disabled, as in compose
GOOGLE_CLIENT_ID=
