    { "source": "ai.dlx", "vhost": "/", "destination": "ai.dlq", "destination_type": "queue", "routing_key": "anomaly" },
    { "source": "ai.direct", "vhost": "/", "destination": "ai.report.q", "destination_type": "queue", "routing_key": "report" },
    { "source": "ai.retry", "vhost": "/", "destination": "ai.report.retry", "destination_type": "queue", "routing_key": "report" },
    { "source": "ai.dlx", "vhost": "/", "destination": "ai.dlq", "destination_type": "queue", "routing_key": "report" },
    { "source": "ticketing.events", "vhost": "/", "destination": "ticketing.hold.released.q", "destination_type": "queue", "routing_key": "ticketing.hold.released" },
