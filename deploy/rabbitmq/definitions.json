{
  "_comment": [
    "Topology AI (BR-A3). Bon hang doi TACH BIET voi consumer pool rieng.",
    "Ly do tach: mot job bao cao chay 2 phut khong duoc phep lam khach trong",
    "phong cho phai cho them 2 phut cho cau tra loi cua minh.",
    "",
    "NGUON CHUAN la code: libs/go/mq/topology.go (AITopology). File nay phai khop;",
    "unit test libs/go/mq doi chieu tung exchange/queue/binding/arguments.",
    "",
    "Giao thuc retry (do consumer dieu khien, header x-ef-attempt bat dau tu 1):",
    "- Loi lan n < 3: publish ban sao (x-ef-attempt = n+1) vao ai.retry voi key = ten",
    "  cong viec -> ai.<job>.retry (hang cho rieng cho tung cong viec: chat 5s,",
    "  moderation 30s, anomaly 30s, report 2m). Het TTL, hang cho dead-letter ve",
    "  ai.direct voi x-dead-letter-routing-key = chinh ten cong viec -> quay lai",
    "  ai.<job>.q. Hang cho dung quorum at-least-once + reject-publish.",
    "- Loi lan 3 hoac loi vinh vien: publish vao ai.dlx voi key = ten cong viec;",
    "  ai.dlq bind tung key (exchange direct, KHONG dung wildcard #).",
    "- Hang goc ai.<job>.q KHONG co x-dead-letter-* va khong co x-max-priority",
    "  (quorum queue khong ho tro priority).",
    "",
    "x-message-ttl cua ai.chat.q la 60s va la CO Y: cau tra loi den sau khi",
    "khach da duoc admit vao mua ve thi khong con gia tri gi. Het TTL thi message",
    "bi BO, khong di retry."
  ],
  "vhosts": [{ "name": "/" }],
  "exchanges": [
    { "name": "ai.direct", "vhost": "/", "type": "direct", "durable": true },
    { "name": "ai.retry", "vhost": "/", "type": "direct", "durable": true },
    { "name": "ai.dlx", "vhost": "/", "type": "direct", "durable": true },
    { "name": "ticketing.events", "vhost": "/", "type": "topic", "durable": true },
    { "name": "notification.direct", "vhost": "/", "type": "direct", "durable": true }
  ],
  "queues": [
    {
      "name": "ai.chat.q", "vhost": "/", "durable": true,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 60000
      }
    },
    {
      "name": "ai.chat.retry", "vhost": "/", "durable": true,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 5000,
        "x-dead-letter-exchange": "ai.direct",
        "x-dead-letter-routing-key": "chat",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ai.moderation.q", "vhost": "/", "durable": true,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 600000
      }
    },
    {
      "name": "ai.moderation.retry", "vhost": "/", "durable": true,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 30000,
        "x-dead-letter-exchange": "ai.direct",
        "x-dead-letter-routing-key": "moderation",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ai.anomaly.q", "vhost": "/", "durable": true,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 1800000
      }
    },
    {
      "name": "ai.anomaly.retry", "vhost": "/", "durable": true,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 30000,
        "x-dead-letter-exchange": "ai.direct",
        "x-dead-letter-routing-key": "anomaly",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ai.report.q", "vhost": "/", "durable": true,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 7200000
      }
    },
    {
      "name": "ai.report.retry", "vhost": "/", "durable": true,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 120000,
        "x-dead-letter-exchange": "ai.direct",
        "x-dead-letter-routing-key": "report",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ai.dlq", "vhost": "/", "durable": true,
      "arguments": { "x-queue-type": "quorum" }
    },
    {
      "name": "ticketing.hold.released.q", "vhost": "/", "durable": true,
      "arguments": { "x-queue-type": "quorum" }
    },
    {
      "name": "notification.email.q", "vhost": "/", "durable": true,
      "arguments": { "x-queue-type": "quorum" }
    }
  ],
  "bindings": [
